# Allowlist: ignore everything, then re-include what belongs here.
# Prevents accidentally committing session data, credentials, or temp files.
*

# Meta
!.gitignore
!.gitattributes

# Claude Code config
!CLAUDE.md
!settings.json
!settings.local.example.json
!.claude/
!.claude/**

# Scripts
!install.sh
!Makefile

# Docs
!README.md
!LICENSE

# Source directories
!hooks/
!hooks/**
!commands/
!commands/**
!skills/
!skills/**
!tests/
!tests/**
